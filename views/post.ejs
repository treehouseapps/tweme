<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="bootstrap/css/bootstrap.css" rel="stylesheet">
    <link href="bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <script src="bootstrap/js/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="style.css">
    <title>
        <%=title%>
    </title>
</head>

<body>
    <%-include('header.ejs')%>

        <div class="container">
            <div class="post">
                <%result.forEach(ite=>{%>
                    <div class="file">
                        <img src="<%=ite.content%>" alt="">
                        <div class="box">
                            <div>
                                <button class="reaction-button" data-id="<%=ite._id%>" reaction="likes">
                                    <i class="bi bi-emoji-laughing"></i>
                                </button>
                                <p class="likes-count">
                                    <%=ite.likes.length%>
                                </p>
                            </div>
                            <div>
                                <button class="reaction-button" data-id="<%=ite._id%>" reaction="dislikes">
                                    <i class="bi bi-emoji-angry"></i>
                                </button>
                                <p class="dislikes-count">
                                    <%=ite.dislikes.length%>
                                </p>
                            </div>
                            <div>
                                <button class="reaction-button" data-id="<%=ite._id%>" reaction="normal">
                                    <i class="bi bi-emoji-neutral"></i>
                                </button>
                                <p class="normal-count">
                                    <%=ite.normal.length%>
                                </p>
                            </div>
                        </div>
                        <div class="box-bottom">
                            <p class="tag"><i>#<%=ite.gener%></i></p>
                            <p style="font-size: small; color: gray;">
                                <i>
                                    <%= ite.createdAt ? formatTime(ite.createdAt) : "From the future" %>
                                </i>
                            </p>
                        </div>
                        <%if(session=='668c06801b92be0ec9efa72c' ){%>
                            <div class="deletebtn"><a href="deletinge/<%=ite._id%>">Delete</a></div>
                            <%}%>
                    </div>
                    <%})%>
            </div>
            <div class="underpost">
                Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Maecenas porttitor congue massa.
                Fusce
                posuere,
                magna sed pulvinar ultricies, purus lectus malesuada libero, sit amet commodo magna eros
                quis urna. Nunc
                viverra imperdiet enim. Fusce est.
            </div>
        </div>
        <%-include('footer.ejs')%>
            <script>
                document.querySelectorAll(".reaction-button").forEach(button => {
                    button.addEventListener("click", function (e) {

                        const postId = this.getAttribute("data-id");
                        const reactionType = this.getAttribute("reaction");
                        const countElement = this.closest(".box").querySelector(`.${reactionType}-count`);

                        if (reactionType == 'likes') { e.target.style.color = "orange" }
                        if (reactionType == 'dislikes') { e.target.style.color = "red" }
                        if (reactionType == 'normal') { e.target.style.color = "blue" }

                        fetch(`/meme_reaction/${postId}/${reactionType}`, { method: "GET" })
                            .then(response => response.json()) // Convert response to JSON
                            .then(data => {
                                if (data.success) {
                                    countElement.innerText = data.value.length; // Update only this post's count
                                } else {
                                    alert(data.message);
                                }
                            })
                            .catch(error => console.error("Error:", error));

                    })
                })
            </script>
</body>

</html>